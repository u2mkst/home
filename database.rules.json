{
  "rules": {
    ".read": "auth != null && auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2'",
    "students": {
      ".read": "auth != null && (auth.uid === '9temrm7WfSXRKo5v5jJiz65t8yF2' || auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2')",
      ".indexOn": [
        "teacher"
      ],
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((auth.uid === $uid && data.exists() && newData.exists()) || auth.uid === '9temrm7WfSXRKo5v5jJiz65t8yF2' || auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2')"
      }
    },
    "public_students": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === '9temrm7WfSXRKo5v5jJiz65t8yF2' || auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2')",
        "name": {
          ".validate": "newData.isString() && newData.val().length < 400"
        },
        "schoolName": {
          ".validate": "newData.isString() && newData.val().length < 100",
          ".write": "auth != null && auth.uid === $uid"
        },
        "teacher": {
          ".validate": "newData.isString() && newData.val().length < 40"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "attendance": {
      ".read": "auth != null && (auth.uid === '9temrm7WfSXRKo5v5jJiz65t8yF2' || auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === '9temrm7WfSXRKo5v5jJiz65t8yF2' || auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2')",
        "$ym": {
          ".validate": "$ym.matches(/^[0-9]{4}-[0-9]{2}$/)",
          "days": {
            "$d": {
              ".validate": "$d.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            }
          }
        }
      }
    },
    "public_attendance_counts": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === '9temrm7WfSXRKo5v5jJiz65t8yF2' || auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2')",
        "$ym": {
          ".validate": "$ym.matches(/^[0-9]{4}-[0-9]{2}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 31"
        }
      }
    },
    "messages": {
      ".read": "auth != null && (auth.uid === '9temrm7WfSXRKo5v5jJiz65t8yF2' || auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2' || (query.orderByChild === 'studentUid' && query.equalTo === auth.uid))",
      ".indexOn": [
        "studentUid",
        "teacher"
      ],
      "$msgId": {
        ".write": "auth != null && (auth.uid === '9temrm7WfSXRKo5v5jJiz65t8yF2' || auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2' || (!data.exists() && newData.child('studentUid').val() === auth.uid && newData.hasChildren(['studentUid', 'teacher', 'message', 'timestamp']) && newData.child('timestamp').val() === now && newData.child('read').val() === false && newData.parent().parent().child('writeThrottle').child(auth.uid).child('messages').val() === now && (!root.child('writeThrottle').child(auth.uid).child('messages').exists() || now - root.child('writeThrottle').child(auth.uid).child('messages').val() >= 3000)))",
        ".validate": "$msgId.matches(/^[-0-9A-Za-z_]{1,40}$/)",
        "message": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length < 5000"
        },
        "replies": {
          "$rid": {
            ".validate": "$rid.matches(/^[-0-9A-Za-z_]{1,40}$/)"
          },
          ".validate": "auth != null && (auth.uid === '9temrm7WfSXRKo5v5jJiz65t8yF2' || auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2')"
        },
        "studentName": {
          ".validate": "newData.isString() && newData.val().length < 200"
        },
        "u2mId": {
          ".validate": "newData.isString() && newData.val().length < 200"
        },
        "teacher": {
          ".validate": "newData.isString() && newData.val().length < 200"
        },
        "$other": {
          ".validate": "auth != null && (auth.uid === '9temrm7WfSXRKo5v5jJiz65t8yF2' || auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2' || $other === 'studentUid' || $other === 'timestamp' || $other === 'read')"
        }
      }
    },
    "student_messages": {
      "$uid": {
        ".indexOn": [
          "read"
        ],
        ".read": "auth != null && (auth.uid === $uid || auth.uid === '9temrm7WfSXRKo5v5jJiz65t8yF2' || auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2')",
        ".write": "auth != null && (auth.uid === '9temrm7WfSXRKo5v5jJiz65t8yF2' || auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2')",
        "$mid": {
          ".validate": "$mid.matches(/^[-0-9A-Za-z_]{1,40}$/)",
          "read": {
            ".write": "auth != null && auth.uid === $uid && data.parent().exists()",
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },
    "lotto_predictions": {
      "$round": {
        ".validate": "$round.matches(/^[0-9]{1,6}$/)",
        ".read": "auth != null && root.child('lottoDraws').child($round).exists()",
        ".write": "auth != null && (auth.uid === '9temrm7WfSXRKo5v5jJiz65t8yF2' || auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2')",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    },
    "device_status": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === '9temrm7WfSXRKo5v5jJiz65t8yF2' || auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2')",
        ".write": "auth != null && ((auth.uid === $uid && newData.child('lastUpdated').val() === now && (!data.child('lastUpdated').exists() || now - data.child('lastUpdated').val() >= 20000)) || auth.uid === '9temrm7WfSXRKo5v5jJiz65t8yF2' || auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2')",
        "battery": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "lastUpdated": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "mathQuizProgress": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === '9temrm7WfSXRKo5v5jJiz65t8yF2' || auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2')",
        ".write": "auth != null && (auth.uid === $uid || auth.uid === '9temrm7WfSXRKo5v5jJiz65t8yF2' || auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2')",
        "$date": {
          ".validate": "$date.matches(/^[0-9]{8}$/)",
          "correctIndexes": {
            "$i": {
              ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.val() === true"
            }
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "studentAchievements": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === '9temrm7WfSXRKo5v5jJiz65t8yF2' || auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2')",
        "$aid": {
          ".write": "auth != null && ((auth.uid === $uid && $aid.matches(/^quiz_[0-9]+$/)) || auth.uid === '9temrm7WfSXRKo5v5jJiz65t8yF2' || auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2')",
          ".validate": "$aid.matches(/^[-0-9A-Za-z_]{1,40}$/) && newData.val() === true"
        }
      }
    },
    "suggestions": {
      ".read": "auth != null && auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2'",
      ".indexOn": [
        "timestamp"
      ],
      "$key": {
        ".write": "auth != null && (auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2' || (!data.exists() && newData.child('studentUid').val() === auth.uid && newData.hasChildren(['studentUid', 'content', 'timestamp']) && newData.child('timestamp').val() === now && newData.parent().parent().child('writeThrottle').child(auth.uid).child('suggestions').val() === now && (!root.child('writeThrottle').child(auth.uid).child('suggestions').exists() || now - root.child('writeThrottle').child(auth.uid).child('suggestions').val() >= 30000)))",
        ".validate": "$key.matches(/^[-0-9A-Za-z_]{1,40}$/)",
        "content": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length < 5000"
        },
        "$other": {
          ".validate": "auth != null && (auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2' || $other === 'studentName' || $other === 'studentUid' || $other === 'schoolName' || $other === 'category' || $other === 'author' || $other === 'authorProfile' || $other === 'timestamp')"
        },
        "studentName": {
          ".validate": "newData.isString() && newData.val().length < 400"
        },
        "schoolName": {
          ".validate": "newData.isString() && newData.val().length < 400"
        },
        "category": {
          ".validate": "newData.isString() && newData.val().length < 400"
        },
        "author": {
          ".validate": "newData.isString() && newData.val().length < 400"
        },
        "authorProfile": {
          ".validate": "newData.isString() && newData.val().length < 400"
        }
      }
    },
    "notice": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.uid === '9temrm7WfSXRKo5v5jJiz65t8yF2' || auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2')"
    },
    "noticeSchedule": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.uid === '9temrm7WfSXRKo5v5jJiz65t8yF2' || auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2')",
      "$id": {
        ".validate": "newData.hasChildren(['text','startAt'])",
        "text": {
          ".validate": "newData.isString() && newData.val().length < 2000"
        },
        "startAt": {
          ".validate": "newData.isNumber()"
        },
        "endAt": {
          ".validate": "newData.isNumber()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "siteSettings": {
      ".read": "auth != null",
      "mathflatStats": {
        "enabled": {
          ".write": "auth != null && auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2'",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "reminder": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.uid === '9temrm7WfSXRKo5v5jJiz65t8yF2' || auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2')"
    },
    "siteMaintenance": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2'"
    },
    "comciganOverrides": {
      ".read": "auth != null",
      "$schoolCode": {
        ".write": "auth != null && auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2'"
      }
    },
    "comciganOverrideMeta": {
      ".read": "auth != null",
      "$schoolCode": {
        ".write": "auth != null && auth.uid === 'OUcTOJNMDVXaMwouAqUluSvd2nH2'"
      }
    },
    "lottoDraws": {
      ".read": "auth != null"
    },
    "writeThrottle": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "$kind": {
          ".validate": "($kind === 'messages' || $kind === 'suggestions') && newData.isNumber() && newData.val() === now"
        }
      }
    }
  }
}
