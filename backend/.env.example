# Copy this file to .env for local `vercel dev` testing.
# In production these are set as Vercel project environment variables instead —
# never commit real values.

# Same AES passphrase the frontend used to hardcode. Keep it identical to the
# old client-side value, otherwise data already encrypted in Firebase becomes
# undecryptable.
AES_KEY=

# NEIS Open API key (https://open.neis.go.kr).
NEIS_API_KEY=

# 기상청 API허브 (https://apihub.kma.go.kr) 인증키. /api/weather가 학원 고정
# 위치(수원 영통구, nx=61/ny=121)의 단기예보(getVilageFcst)를 가져오는 데 쓴다.
KMA_API_KEY=

# Contents of the Firebase service account JSON (Project settings > Service
# accounts > Generate new private key), collapsed to a single line.
FIREBASE_SERVICE_ACCOUNT=

# Origin allowed to call these APIs from a browser, e.g. https://u2mkst.github.io
ALLOWED_ORIGIN=

# 학생 PIN(4자리) 해시에 섞는 서버 전용 비밀값(pepper). 32자 이상 무작위 문자열.
# 예) PowerShell:  -join ((48..57)+(97..122) | Get-Random -Count 48 | % {[char]$_})
# ⚠️ 한 번 정하면 바꾸지 말 것 — 바꾸면 저장된 모든 PIN 해시가 무효가 된다.
PIN_PEPPER=

# reCAPTCHA v3 시크릿 키(로그인/가입 봇 점수 검증용).
RECAPTCHA_V3_SECRET_KEY=

# Vercel 크론(로또 추첨 결과 저장)이 /api/lotto를 호출할 때 쓰는 비밀값. 임의의 긴 문자열.
CRON_SECRET=
