{
  "name": "kst-rules-test",
  "private": true,
  "version": "1.0.0",
  "description": "database.rules.json 과 로그인 보안(잠금·IP 제한·관리자 서버 로그인)을 Firebase 에뮬레이터에서 검증하는 테스트",
  "scripts": {
    "test": "firebase emulators:exec --only database --project demo-kst \"node rules.test.js\"",
    "test:auth": "firebase emulators:exec --only auth,database --project demo-kst \"node auth.test.js\"",
    "abuse": "firebase emulators:exec --only database --project demo-kst \"node abuse-baseline.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.0",
    "crypto-js": "^4.1.1",
    "firebase": "^10.0.0",
    "firebase-admin": "^12.1.0",
    "firebase-tools": "^13.0.0"
  }
}
